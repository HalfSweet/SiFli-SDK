+__ROM_SIZE = {{ hex32(defines['__ROM_SIZE']) }};
+
+__RAM_BASE = {{ hex32(defines['__RAM_BASE']) }};
+__RAM_SIZE = {{ hex32(defines['__RAM_SIZE']) }};
+
+__STACK_SIZE = 0x00002000;
+__HEAP_SIZE  = 0x00000C00;
+
+__ROM_EX_BASE = {{ hex32(defines['__ROM_EX_BASE']) }};
+__ROM_EX_SIZE = {{ hex32(defines['__ROM_EX_SIZE']) }};
+
+__PSRAM_BASE = {{ hex32(defines['__PSRAM_BASE']) }};
+__PSRAM_SIZE = {{ hex32(defines['__PSRAM_SIZE']) }};
+
+__ROM2_BASE = {{ hex32(defines['__ROM2_BASE']) }};
+__ROM2_SIZE = {{ hex32(defines['__ROM2_SIZE']) }};
+
+__ROM3_BASE = {{ hex32(defines['__ROM3_BASE']) }};
+__ROM3_SIZE = {{ hex32(defines['__ROM3_SIZE']) }};
+
+MEMORY
+{
+    ROM (rx) : ORIGIN = __ROM_BASE, LENGTH = __ROM_SIZE
+    RAM (rw) : ORIGIN = __RAM_BASE, LENGTH = __RAM_SIZE
+    ROM_EX(rw):ORIGIN = __ROM_EX_BASE, LENGTH = __ROM_EX_SIZE
+    PSRAM(rw): ORIGIN = __PSRAM_BASE, LENGTH = __PSRAM_SIZE
+    ROM2 (rx): ORIGIN = __ROM2_BASE, LENGTH = __ROM2_SIZE
+    ROM3 (rx): ORIGIN = __ROM3_BASE, LENGTH = __ROM3_SIZE
